# Normalize line endings for source and documentation files.
* text=auto eol=lf

*.go    text eol=lf
*.mod   text eol=lf
*.sum   text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.sh    text eol=lf
*.ps1   text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf

# Binary assets must never be normalized.
*.png   binary
*.ico   binary
*.icns  binary
*.syso  binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.exe   binary
*.dll   binary
